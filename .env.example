# ==============================================================================
# MiniGuard Bot — Production Environment Variables
# ==============================================================================

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"

# 2. Telegram Bot Mode: "polling" (recommended & zero config) or "webhook"
BOT_MODE="polling"

# 3. Webhook URL (only required if BOT_MODE=webhook)
# WEBHOOK_URL="https://your-domain.com/webhook"

# 4. Public Mini App Web URL (e.g. from Cloudflare Pages or your VPS domain)
# Example: https://miniguard-app.pages.dev OR https://your-server-ip-guard.sslip.io
MINI_APP_URL="https://miniguard-app.pages.dev"

# 5. Internal HTTP Server Port (Default is 3000 inside container, exposed as 3001 on host)
PORT=3000

# 6. Master Owner Telegram ID (Your numeric Telegram User ID)
OWNER_TELEGRAM_ID=123456789

# 7. Optional: Gemini API Key (For AI moderation features)
GEMINI_API_KEY=""
